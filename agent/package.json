{
  "name": "proofsec-agent-executor",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "build:lambda": "esbuild lambda.ts --bundle --platform=node --target=node22 --format=cjs --external:@aws-sdk/client-ssm --outfile=.aws-sam/preflight/lambda.cjs --sourcemap",
    "check:lambda-bundle": "npm run build:lambda && node -e \"const m=require('./.aws-sam/preflight/lambda.cjs'); if(typeof m.handler!=='function') throw new Error('handler ausente'); console.log('handler OK')\"",
    "executor": "tsx executor.ts",
    "executor:once": "tsx executor.ts --once",
    "keygen": "tsx executor.ts --keygen",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test core.test.ts"
  },
  "dependencies": {
    "@anchor-lang/core": "^1.0.0",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.98.0"
  },
  "devDependencies": {
    "@aws-sdk/client-ssm": "^3.700.0",
    "@types/node": "^22",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
