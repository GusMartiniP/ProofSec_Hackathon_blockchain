# Copie para .env.local e preencha.

# RPC dedicado (Helius/Triton). O público da devnet tem rate limit e falha em demo ao vivo.
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
# Opcional: RPC secundário (PS-13)
NEXT_PUBLIC_RPC_URL_FALLBACK=
NEXT_PUBLIC_CLUSTER=devnet

# Endereço do programa após `anchor deploy` (se vazio, usa o do IDL).
NEXT_PUBLIC_PROGRAM_ID=

# USDC da Circle na devnet (faucet: https://faucet.circle.com)
NEXT_PUBLIC_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Saída `ApiEndpoint` do `sam deploy`. Se vazio, o app roda em modo "só on-chain"
# (sem metadados, sem upload de relatório cifrado e sem agente).
NEXT_PUBLIC_API_URL=

# A chave de criptografia do árbitro vem do backend (o árbitro de cada job precisa
# clicar em "Ativar criptografia" uma vez). Não há mais NEXT_PUBLIC_ARBITER_ENC_PUBKEY.

# Bucket de relatórios (saída `ReportsBucketName` do backend). Restringe o connect-src da CSP ao host
# desse bucket em vez de `*.amazonaws.com` (PS-47). Região padrão: us-east-1.
NEXT_PUBLIC_REPORTS_BUCKET=
NEXT_PUBLIC_REPORTS_REGION=
